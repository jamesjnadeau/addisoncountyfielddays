doctype html

html(lang='en')
  head
    meta(charset='utf-8')
    meta(http-equiv='X-UA-Compatible', content='IE=edge')
    if title
      title !{title}
    if description
      meta(name='description', content='#{description}')
    meta(name='robots', content='robots.txt')
    meta(name='viewport', content='width=device-width, initial-scale=1.0, maximum-scale=2.0, user-scalable=1')
    meta(name='author', content='James J Nadeau')

    link(rel='manifest', href='/manifest.json')
    link(rel="shortcut icon" href="/files/favicon.ico" type="image/x-icon")
    link(rel="icon" href="/files/favicon.ico" type="image/x-icon")

    link(href='/styles/main.css', rel='stylesheet', type='text/css')


  body
    nav#header.navbar.navbar-expand-lg.navbar-dark.m-0
      //- .d-flex.justify-content-between
      .container-fluid
        img.pull-left.brand.hidden-xs.hidden-sm(src="/files/logo.jpg")
        a.navbar-brand.brand(href='/') Addison County Fair
          br
          | & Field Days
        button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarSupportedContent', aria-controls='navbarSupportedContent', aria-expanded='false', aria-label='Toggle navigation')
          span.navbar-toggler-icon
        #navbarSupportedContent.navbar-collapse
          ul.navbar-nav.d-flex.justify-content-around.align-items-center.w-100
                li
                  a(href='/information/') General Information
                li
                  a(href='/schedule/') Schedule
                li
                  a(href='/exhibits/') Exhibits
                li
                    a(href='/forms/') Forms
    #wrap-content(data-barba="wrapper")  
      #container.container.animate__animated.animate__zoomIn(data-barba="container" data-barba-namespace=page.url)
        block content
          div !{content}

    footer.footer
      .container
        - var year = new Date().getFullYear();
        p.text-center &copy; Copyright ##{year}
        p.text-muted.text-center
          | This site was crafted by&nbsp;
          a(href="https://jamesjnadeau.com") James Nadeau
          | &nbsp;with the help of the Board of Directors.
          br
          //- a(href="/contact") Need to contact us?
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js', integrity='sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL', crossorigin='anonymous')
    script(src='https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js')
    script(src="https://cdn.jsdelivr.net/npm/@barba/core")
    script.
      // Style tables in markdown content
      $('.markdown-content table').addClass('table table-striped table-hover');

      $('.toggle-all-panels').on('click', function () {
        $('.panel-collapse').collapse('show');
      });
    
    script.
    
      var inAnimationClass = 'animate__zoomIn';
      var outAnimationClass = 'animate__zoomOutUp';
      barba.init({
        transitions: [{
          name: 'default-transition',
          leave(data) {
            target = data.current.container
            target.classList.remove(inAnimationClass);
            target.classList.add(outAnimationClass);
            var promise = new Promise(function(resolve, reject) {
              target.addEventListener('animationend', function(event) {
                target.style.display = 'none'; // hide leaving page after animation is complete
                resolve();
              },{once: true}); // remove event after run once
            });
            return promise;
          },
          enter(data) {
            target = data.next.container
            target.classList.remove('animate__animated');
            var promise = new Promise(function(resolve, reject) {
              target.addEventListener('animationend', function(event) {
                resolve();
              },{once: true}); // remove event after run once
            });
            target.classList.add('animate__animated')
            return promise;
          }
        }]
      });

    block scripts
    // Global site tag (gtag.js) - Google Analytics
    script(async='', src='https://www.googletagmanager.com/gtag/js?id=UA-101892804-1')
    script.
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments)};
      gtag('js', new Date());
      gtag('config', 'UA-101892804-1');
